# Copy to .streamlit/secrets.toml (never commit it) or paste into the
# Streamlit Community Cloud app's Settings > Secrets. Environment variables
# with the same names take precedence.

# Where accounts are stored. Required for hosted deployments: Streamlit Cloud
# has no persistent disk, so without this, accounts are lost on every restart.
LCA_DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Public address of the app, used in password links.
LCA_APP_BASE_URL = "https://your-app.streamlit.app"

# First administrator. Used only while no account exists yet.
# Generate the hash locally with: python manage_users.py hash
LCA_ADMIN_EMAIL = "admin@company.com"
LCA_ADMIN_NAME = "Administrator"
LCA_ADMIN_PASSWORD_HASH = "scrypt$16384$8$1$..."

# Optional: email for password reset and new-account links.
# SMTP_HOST = "smtp.office365.com"
# SMTP_PORT = "587"
# SMTP_USERNAME = ""
# SMTP_PASSWORD = ""
# SMTP_FROM = "no-reply@company.com"
